# backend/.env 로 복사해서 사용 (backend/.env는 커밋 금지)
APP_ENV=local
# 로컬 docker-compose DB 기준 (asyncpg 드라이버 필수)
DATABASE_URL=postgresql+asyncpg://steammate:steammate@localhost:5433/steammate
# https://steamcommunity.com/dev/apikey 에서 발급, 서버에만 보관
STEAM_API_KEY=
# 콤마 구분 또는 JSON 배열
CORS_ORIGINS=http://localhost:3000
# 세션 쿠키 서명 키(32자 이상). 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# 브라우저가 접속하는 프론트 주소 (Steam 로그인 return_to·realm)
PUBLIC_BASE_URL=http://localhost:3000
